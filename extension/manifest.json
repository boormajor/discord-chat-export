{
  "manifest_version": 3,
  "name": "DM Archive — Discord-style export",
  "version": "2.2.0",
  "description": "Local Discord DM archive with adaptive scroll capture, stall recovery, and Discord-style exports. No tokens.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://cdn.discordapp.com/*",
    "https://*.discordapp.net/*",
    "https://*.tenor.com/*",
    "https://*.giphy.com/*",
    "https://*.imgur.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DM Archive",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/@me/*"
      ],
      "js": [
        "zip.js",
        "renderer.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
